# Server-only secrets. Never prefix these with VITE_ — that would ship them to the browser.

# Narrator (required): https://console.groq.com/keys
GROQ_API_KEY=

# Portraits, scenes and enemies (optional): a Hugging Face token with "Inference Providers" permission.
# Without it the game runs with placeholder art.
HF_TOKEN=

# Narrator voice (optional): the Orpheus voice to speak with (troy, austin, hannah...).
# The account owner must accept the model terms once at
# https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
# TTS_VOICE=troy

# Where generated images are cached (default: .cache/images, /tmp on Vercel)
# IMAGE_CACHE_DIR=
